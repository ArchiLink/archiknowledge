# Copy this file to .env and fill in the values. Never commit .env.

# --- Network ---
# Intranet IP of the machine running the portal (fixed/reserved IP recommended).
PORTAL_ADDRESS=192.168.0.10
# Port the portal listens on. Use 80 so the WordPress link needs no port.
PORTAL_PORT=80
# Optional: WordPress address allowed to show /embed/ticker/ in an iframe,
# e.g. http://192.168.0.5. Leave empty to run fully standalone (no framing).
FRAME_ANCESTORS=

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
PORTAL_NAME=Design Quality Log
# IANA time zone name, e.g. America/Toronto
TIME_ZONE=UTC

# --- Database ---
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me

# --- Email (fill in once the mail server is set up) ---
# Leave EMAIL_HOST empty to disable sending; emails are skipped and noted in the logs.
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=
# Who receives the Quality Alert digest (comma-separated, e.g. a staff distribution list).
QUALITY_ALERT_RECIPIENTS=

# --- Uploads ---
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_LESSON=6
